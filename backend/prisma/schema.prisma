// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserPlan {
  FREE
  PREMIUM
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  googleId  String?  @unique
  apiKey    String   @unique @default(cuid()) // App API Key (for mobile app)
  devApiKey String   @unique @default(cuid()) // Developer API Key (for verification)
  plan      UserPlan @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patterns     Pattern[]
  transactions Transaction[]
  auditLogs    AuditLog[]
  usageStats   UsageStats?

  @@index([apiKey])
  @@index([devApiKey])
  @@index([email])
  @@index([phone])
}

model Pattern {
  id           String   @id @default(cuid())
  userId       String
  name         String
  regex        String
  extractFields Json   // { amount: 1, sender: 2, txnId: 3, bank: 4 }
  bank         String?
  currency     String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  txnId     String
  amount    Float
  sender    String   // masked phone number
  bank      String?
  patternId String?
  receivedAt DateTime
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)

  @@unique([userId, txnId])
  @@index([userId])
  @@index([txnId])
  @@index([userId, txnId])
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, code])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // e.g., "pattern_created", "transaction_ingested", "verification_requested"
  endpoint  String
  ipAddress String?
  metadata  Json?    // Additional context
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model UsageStats {
  id                String   @id @default(cuid())
  userId            String   @unique
  appRequestsToday  Int      @default(0) // Ingest requests from mobile app
  appRequestsMonth  Int      @default(0)
  devRequestsToday  Int      @default(0) // Verification requests from developers
  devRequestsMonth  Int      @default(0)
  lastResetDate     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

